# ProtonVPN WireGuard key: account.protonvpn.com → Downloads → WireGuard configuration.
# Pick "GNU/Linux", turn on "NAT-PMP (Port Forwarding)", choose any P2P server, and copy
# the PrivateKey line from the generated config.
WIREGUARD_PRIVATE_KEY=

# SERVER_COUNTRIES=Netherlands
# TZ=Europe/Amsterdam
# WEBUI_PORT=8080
# Owner of ./data on the host (`id -u` / `id -g`)
# PUID=1000
# PGID=1000
