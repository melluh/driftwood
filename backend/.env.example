DRIFTWOOD_TMDB__API_KEY=your-tmdb-v3-api-key

# Optional: TorrentLeech release search (set "Torrents per page" to 100 in your TL profile)
# DRIFTWOOD_INDEXERS__TORRENTLEECH__USERNAME=
# DRIFTWOOD_INDEXERS__TORRENTLEECH__PASSWORD=
# DRIFTWOOD_INDEXERS__TORRENTLEECH__ALT_2FA_TOKEN=

# OpenID Connect login (any OIDC provider: Google, Authentik, Keycloak, Pocket ID, ...).
# Register <public_url>/api/auth/callback as the redirect URI, e.g.
# http://localhost:5173/api/auth/callback in development.
DRIFTWOOD_AUTH__ISSUER_URL=https://accounts.google.com
DRIFTWOOD_AUTH__CLIENT_ID=your-client-id
DRIFTWOOD_AUTH__CLIENT_SECRET=your-client-secret
DRIFTWOOD_AUTH__PROVIDER_NAME=Google
DRIFTWOOD_AUTH__PUBLIC_URL=http://localhost:5173
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DRIFTWOOD_AUTH__SECRET_KEY=change-me

# DRIFTWOOD_DATABASE__URL=sqlite+aiosqlite:///data/driftwood.db

# Shared media library roots; each root kind determines movie vs TV matching.
# Paths must include [tmdbid-123] (or another supported TMDB tag) in a filename or parent folder.
# DRIFTWOOD_LIBRARY__ROOTS='[{"name":"movies","path":"/srv/movies","kind":"movies"},{"name":"tv","path":"/srv/tv","kind":"tv"}]'

# Playing from the library needs ffmpeg and ffprobe on PATH. Segments and extracted
# subtitles go here (default: driftwood-playback in the system temp directory).
# DRIFTWOOD_PLAYBACK__DIRECTORY=/var/cache/driftwood/playback
# DRIFTWOOD_PLAYBACK__SEGMENT_SECONDS=6
# DRIFTWOOD_PLAYBACK__LEAD_SEGMENTS=10
# Sandbox ffmpeg/ffprobe with bubblewrap (install `bubblewrap`): auto (where it works, warning
# otherwise), bwrap (required: no playback without it), or off
# DRIFTWOOD_PLAYBACK__SANDBOX=auto
# Seconds between seek-bar (trickplay) thumbnails: the ones Jellyfin saved next to videos
# (Jellyfin's default) and the ones Driftwood makes itself
# DRIFTWOOD_PLAYBACK__TRICKPLAY_INTERVAL_SECONDS=10
# Make thumbnails, next to the video the Jellyfin way, for videos without them: right after a
# download is imported and when one is first played. Needs writable library folders.
# DRIFTWOOD_PLAYBACK__TRICKPLAY_GENERATE=true
# DRIFTWOOD_PLAYBACK__TRICKPLAY_WIDTH=320
# ffmpeg processes making thumbnail sheets at once (default: half the CPU cores, at most 8)
# DRIFTWOOD_PLAYBACK__TRICKPLAY_WORKERS=4

# Download & play through qBittorrent's WebUI. Finished downloads are hardlinked into the
# library roots above (copied when they're on another filesystem).
# DRIFTWOOD_DOWNLOADS__QBITTORRENT__URL=http://localhost:8080
# API key from qBittorrent 5.2+ (Options → WebUI → API Key → Generate)
# DRIFTWOOD_DOWNLOADS__QBITTORRENT__API_KEY=qbt_...
# DRIFTWOOD_DOWNLOADS__QBITTORRENT__CATEGORY=driftwood
# When qBittorrent sees the download directory under another path (e.g. in a container):
# DRIFTWOOD_DOWNLOADS__QBITTORRENT__PATH_MAPPINGS='[{"remote":"/downloads","local":"/srv/torrents"}]'
# DRIFTWOOD_DOWNLOADS__SUBTITLES=true
# DRIFTWOOD_DOWNLOADS__FALLBACK=copy

# Wanted subtitle languages (names or ISO codes, JSON list); [] turns subtitle checks off
# DRIFTWOOD_SELECTION__SUBTITLE_LANGUAGES=["en"]
